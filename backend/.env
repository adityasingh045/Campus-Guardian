# Copy to .env and fill in before running.

# REQUIRED: generate with `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`
API_KEY=FfObbWwLNWQcwT451zGjyVWq5m5AmtbFV18VF3F6HI4

# Set to true ONLY for a quick local demo with no auth. Do not use this on
# any network you don't fully trust -- it exposes the live camera feed.
ALLOW_NO_AUTH=true

# "0" = default webcam, or an RTSP URL, or a path to a video file.
CAMERA_SOURCE=0
TEST_VIDEO_FALLBACK=true

MODEL_PATH=yolov8n-pose.pt
DEVICE=cpu
TARGET_FPS=15
BROADCAST_FPS=15

CONFIRM_FRAMES=5
CONFIRM_RATIO=0.6
COOLDOWN_SECONDS=30

SNAPSHOT_RETENTION_DAYS=14
CLEANUP_INTERVAL_SECONDS=3600

WS_MAX_CONNECTIONS=20
WS_CLIENT_QUEUE_SIZE=1

# Leave both blank to disable Telegram notifications (no-op, not an error).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_INTERVAL_SECONDS=3

# Comma-separated in production, e.g. https://campus.example.edu
CORS_ORIGINS=*
ALLOW_NO_AUTH=true
